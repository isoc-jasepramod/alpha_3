{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:3000",
    "distDir": "../dist"
  },
  "package": {
    "productName": "ProjectAlpha",
    "version": "2.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://localhost:8000/*", "ws://localhost:8000/*"]
      }
    },
    "bundle": {
      "active": true,
      "category": "Finance",
      "copyright": "Project Alpha 2.0",
      "identifier": "com.alpha.advisory",
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 920,
        "resizable": true,
        "title": "Project Alpha 2.0 | Quantitative Advisory Terminal",
        "width": 1440,
        "minHeight": 700,
        "minWidth": 1000
      }
    ]
  }
}
